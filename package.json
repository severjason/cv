{
  "name": "cv",
  "version": "1.2.5",
  "author": "Sergii Severynov",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "analyze": "ANALYZE=true npm run build",
    "start": "next start",
    "tscheck": "next typegen && tsc --pretty --noEmit",
    "format": "prettier --write '**/*.{js,ts,tsx}' -u",
    "lint": "oxlint . && prettier --check \"**/*.{js,ts,tsx,mjs}\" -u",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.@(ts|tsx)": [
      "prettier --write",
      "oxlint"
    ]
  },
  "babel": {
    "presets": [
      "next/babel"
    ]
  },
  "dependencies": {
    "@next/bundle-analyzer": "^16.4.6",
    "@serwist/next": "^9.5.15",
    "@vercel/speed-insights": "^2.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "i18next": "^27.2.2",
    "mongoose": "^9.12.3",
    "next": "^16.4.6",
    "next-connect": "^1.0.0",
    "next-i18next": "^16.5.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "oxlint": "^1.94.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "serwist": "^9.5.15",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=22.22.1"
  }
}
