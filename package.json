    "mongoose": "^9.12.3",
    "next": "^16.4.6",
    "next-connect": "^1.0.0",
    "next-i18next": "^16.5.1",
    "next-pwa": "^5.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
